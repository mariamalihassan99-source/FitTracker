<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <title>Home</title>
</head>
<body>
    <%- include('../partials/navbar') %>



    <h2>Add New Measurement</h2>

<div class="measurement-layout">

    <form action="/measurements" method="POST" class="form-section">

        <label for="weight">Weight:</label>
        <input type="number" name="weight" id="weight" required>

        <label for="height">Height:</label>
        <input type="number" name="height" id="height" required>

        <label for="chest">Chest:</label>
        <input type="number" name="chest" id="chest">

        <label for="waist">Waist:</label>
        <input type="number" name="waist" id="waist">

        <label for="hips">Hips:</label>
        <input type="number" name="hips" id="hips">

        <label for="goal">Your weight goal:</label>
        <input type="text" name="goal" id="goal">

        <button type="submit">Add Measurement</button>

    </form>

    <div class="image-section">
        <img src="/images/image.png" alt="Body Measurements">
    </div>

</div>
            <h2>Your Body Measurements</h2>

<div class="measurements-container">
    <% measurements.forEach(measurement => { %>

        <div class="measurement-card">

            <h2><%= measurement.date.toDateString() %></h3>
            <!-- Display the body measurements / strong to make the label is bold -->
            <p><strong>Weight:</strong> <%= measurement.weight %> kg</p>
            <p><strong>Height:</strong> <%= measurement.height %> cm</p>
            <p><strong>Chest:</strong> <%= measurement.chest %> cm</p>
            <p><strong>Waist:</strong> <%= measurement.waist %> cm</p>
            <p><strong>Hips:</strong> <%= measurement.hips %> cm</p>
            <p><strong>Goal:</strong> <%= measurement.goal %></p>

            <div class="buttons">

                <form action="/measurements/<%= measurement._id %>?_method=DELETE" method="POST">
                    <button type="submit" class="delete-btn">
                        Delete
                    </button>
                </form>

                <form action="/measurements/edit/<%= measurement._id %>" method="GET">
                    <button type="submit" class="edit-btn">
                        Edit
                    </button>
                </form>

            </div>

        </div>

    <% }) %>
</div>

</body>
</html>