<%
const calories = Number(latestProgress?.caloriesBurned || 0);
const exercise = Number(latestProgress?.duration || 0);
const steps = Number(latestProgress?.steps || 0);
const water = Number(latestProgress?.waterAmount || 0);

const caloriesPercent = Math.min(calories / 760, 1);
const exercisePercent = Math.min(exercise / 60, 1);
const stepsPercent = Math.min(steps / 8000, 1);
const waterPercent = Math.min(water / 2500, 1);
%>






<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <link rel="stylesheet" href="/css/style.css">

  <style>
@import url('https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=Edu+QLD+Hand:wght@400..700&family=Josefin+Sans:ital,wght@0,100..700;1,100..700&display=swap');
</style>

</head>
<body>
    <%- include('./partials/navbar') %>

    <h3>FitTrack</h3>


     
<section class="activity-card">
    <h2>Activity Rings</h2>

    <div class="activity-content">

        <div class="rings">
            <svg viewBox="0 0 240 240">

                <!-- Calories -->
                <circle class="ring move-bg" cx="120" cy="120" r="100"/>
                <circle class="ring move-progress"
                    cx="120" cy="120" r="100"
                    style="stroke-dashoffset: <%= 628.32 * (1 - caloriesPercent) %>"/>

                <!-- Exercise -->
                <circle class="ring exercise-bg" cx="120" cy="120" r="76"/>
                <circle class="ring exercise-progress"
                    cx="120" cy="120" r="76"
                    style="stroke-dashoffset: <%= 477.52 * (1 - exercisePercent) %>"/>

                <!-- Steps -->
                <circle class="ring steps-bg" cx="120" cy="120" r="52"/>
                <circle class="ring steps-progress"
                    cx="120" cy="120" r="52"
                    style="stroke-dashoffset: <%= 326.73 * (1 - stepsPercent) %>"/>

                <!-- Water -->
                <circle class="ring water-bg" cx="120" cy="120" r="28"/>
                <circle class="ring water-progress"
                    cx="120" cy="120" r="28"
                    style="stroke-dashoffset: <%= 175.93 * (1 - waterPercent) %>"/>

            </svg>
        </div>

        <div class="activity-details">

            <div>
                <h2>Calories Burned</h2>
                <p class="pink"><%= calories %>/760 KCAL</p>
            </div>

            <div>
                <h2>Exercise</h2>
                <p class="green"><%= exercise %>/60 MIN</p>
            </div>

            <div>
                <h2>Steps</h2>
                <p class="purple"><%= steps %>/8,000 STEPS</p>
            </div>

            <div>
                <h2>Water</h2>
                <p class="blue"><%= water %>/2,500 ML</p>
            </div>

        </div>
    </div>
</section>

</body>
</html>