

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="/css/auth.css">

    <title>FitTrack | Sign In</title>
</head>

<body>

    <%- include('../partials/navbar') %>

    <main class="auth-container">

        <div class="auth-card">

            <h1>fittrack</h1>
            <P>Track your fitness progress with ease</P>
            <p class="auth-subtitle">Sign in to continue your fitness journey.</p>

            <form action="/auth/sign-in" method="POST" class="auth-form">

                <div class="auth-group">
                    <label for="username">Username</label>
                    <input
                        type="text"
                        name="username"
                        id="username"
                        placeholder="Enter your username"
                        required
                    >
                </div>

                <div class="auth-group">
                    <label for="password">Password</label>
                    <input
                        type="password"
                        name="password"
                        id="password"
                        placeholder="Enter your password"
                        required
                    >
                </div>

                <button type="submit">Sign In</button>

            </form>

        </div>

        <div class="auth-features">
    <div class="feature-item">
        <span>🏋️</span>
        <p>Track Workouts</p>
    </div>

    <div class="feature-item">
        <span>📈</span>
        <p>Monitor Progress</p>
    </div>

    <div class="feature-item">
        <span>🎯</span>
        <p>Reach Your Goals</p>
    </div>
</div>

    </main>

</body>
</html>
