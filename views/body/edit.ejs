

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/BodyMeasurements.css">
    <title>FitTrack | Edit Measurement</title>
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="measurement-layout">

        <!-- Edit Form -->
        <div class="measurement-edit-card">
            <h2>Update Measurement</h2>
            <p>Edit your body measurements and keep track of your progress.</p>

            <form action="/measurements/<%= measurement._id %>?_method=PUT" method="POST">

                <div class="measurement-group">
                    <label for="weight">Weight (kg)</label>
                    <input type="number" step="0.1" name="weight" id="weight"
                        value="<%= measurement.weight %>" required>
                </div>

                <div class="measurement-group">
                    <label for="height">Height (cm)</label>
                    <input type="number" step="0.1" name="height" id="height"
                        value="<%= measurement.height %>" required>
                </div>

                <div class="measurement-group">
                    <label for="chest">Chest (cm)</label>
                    <input type="number" step="0.1" name="chest" id="chest"
                        value="<%= measurement.chest %>">
                </div>

                <div class="measurement-group">
                    <label for="waist">Waist (cm)</label>
                    <input type="number" step="0.1" name="waist" id="waist"
                        value="<%= measurement.waist %>">
                </div>

                <div class="measurement-group">
                    <label for="hips">Hips (cm)</label>
                    <input type="number" step="0.1" name="hips" id="hips"
                        value="<%= measurement.hips %>">
                </div>

                <div class="measurement-group">
                    <label for="goal">Your Weight Goal</label>
                    <input type="text" name="goal" id="goal"
                        value="<%= measurement.goal %>">
                </div>

                <button type="submit">Update Measurement</button>
            </form>
        </div>

        <!-- Measurement Guide -->
        <div class="measurement-guide">
            <img src="https://cdn.corenexis.com/f/5ehlnYVc.png"
                 alt="Body Measurement Guide">
        </div>

    </div>

</body>
</html>
