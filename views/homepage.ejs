<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <link rel="stylesheet" href="/css/style.css">

  <style>
@import url('https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=Edu+QLD+Hand:wght@400..700&family=Josefin+Sans:ital,wght@0,100..700;1,100..700&display=swap');
</style>

</head>
<body>
    <%- include('./partials/navbar') %>

    <h3>FitTrack</h3>


     <section class="activity-card">
            <h2>Activity Rings</h2>

            <div class="activity-content">

                <div class="rings">
                    <svg viewBox="0 0 240 240">
                        <circle class="ring move-bg" cx="120" cy="120" r="100"/>
                        <circle class="ring move-progress" cx="120" cy="120" r="100"/>

                        <circle class="ring exercise-bg" cx="120" cy="120" r="76"/>
                        <circle class="ring exercise-progress" cx="120" cy="120" r="76"/>

                        <circle class="ring stand-bg" cx="120" cy="120" r="52"/>
                        <circle class="ring stand-progress" cx="120" cy="120" r="52"/>
                    </svg>
                </div>

               <div class="activity-details">

    <div>
        <h2>Calories Burned</h2>
        <p class="pink">
            <%= latestProgress?.caloriesBurned || 0 %>/760 KCAL
        </p>
    </div>

    <div>
        <h2>Exercise</h2>
        <p class="green">
            <%= latestProgress?.duration || 0 %>/60 MIN
        </p>
    </div>

    <div>
        <h2>Steps</h2>
        <p class="purple">
            <%= latestProgress?.steps || 0 %>/8,000 STEPS
        </p>
    </div>

    <div>
        <h2>Water</h2>
        <p class="blue">
            <%= latestProgress?.waterAmount || 0 %>/2,500 ML
        </p>
    </div>

</div>

            </div>
        </section>
    
</body>
</html>