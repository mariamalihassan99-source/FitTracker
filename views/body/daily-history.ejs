<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <link rel="stylesheet" href="/css/style.css">

  <style>
@import url('https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=Edu+QLD+Hand:wght@400..700&family=Josefin+Sans:ital,wght@0,100..700;1,100..700&display=swap');
</style>

</head>
<body>
    <%- include('../partials/navbar') %>

   <h2> Your Daily History</h2>
   <table>
       <thead>
           <tr>
               <th>Date</th>
               <th>Workout Type</th>
               <th>Duration</th>
               <th>Calories Burned</th>
               <th>Weight</th>
               <th>Water Intake</th>
               <th>Sleep Hours</th>
               <th>Steps</th>
           </tr>
       </thead>
       <tbody>
           <% progresses.forEach(progress => { %>
               <tr>
                   <td><%= progress.date.toDateString() %></td>
                   <td><%= progress.workoutType %></td>
                   <td><%= progress.duration %></td>
                   <td><%= progress.caloriesBurned %></td>
                   <td><%= progress.weight %></td>
                   <td><%= progress.waterAmount %></td>
                   <td><%= progress.sleepHours %></td>
                   <td><%= progress.steps %></td>
               </tr>
           <% }) %>
       </tbody>
   </table>
    
</body>
</html>