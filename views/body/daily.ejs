<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <link rel="stylesheet" href="/css/style.css">

  <style>
@import url('https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=Edu+QLD+Hand:wght@400..700&family=Josefin+Sans:ital,wght@0,100..700;1,100..700&display=swap');
</style>

</head>
<body>
    <%- include('../partials/navbar') %>

    <main class="daily-tracker-main">

        <header class="daily-tracker-header">
    <div>
    <h2>Daily tracker</h2>
     <p>Track your daily fitness journey</p>
    </div>
    <input type="date" id="progressDate">
    </header>
    

    <!-- Daily tracker content goes here -->

    <section class="daily-tracker-content">

        <div class="daily-tracker-entry">
             <span>⚖️</span>
                <p>Weight</p>
                <h2>60 kg</h2>
        </div>


      <div class="daily-tracker-entry">
                <span>🔥</span>
                <p>Calories Burned</p>
                <h2>350 kcal</h2>
            </div>

            <div class="daily-tracker-entry">
               <span>💧</span>
               <p>Water Intake</p>
               <h2>2 L</h2>
            </div>

            <div class="daily-tracker-entry">
               <span>🏃‍♂️</span>
               <p>Steps</p>
               <h2>10,000</h2>
            </div>

            <div class="daily-tracker-entry">
               <span>🌙</span>
               <p>Sleep</p>
               <h2>8 hrs</h2>
            </div>

    </section>








    </main>
</body>
</html>